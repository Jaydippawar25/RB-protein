# Firebase Web SDK config (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# JWT signing secret used by the custom-claims/cloud-function layer
VITE_JWT_SECRET=replace_with_long_random_secret

# Optional: AI provider key for chatbot/recommendations (server-side proxy recommended)
VITE_AI_API_URL=https://your-cloud-function-url/chat
