rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.role == 'admin'; }

    // Product images — admins upload, anyone can view
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User avatars — owner or admin only
    match /avatars/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
